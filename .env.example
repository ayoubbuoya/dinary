# Copy this file to .env.local for local development (it is git-ignored).
# On Vercel, add the server values in Project → Settings → Environment Variables.

# --- Server only (never prefix these with EXPO_PUBLIC_) ---
# MongoDB Atlas → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dinary
# The password you type to open Dinary on the website (and once on the phone). Use a long one.
DINARY_PASSWORD=change-me-to-a-long-password
# Random secret used to sign sessions, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs out every browser and phone.
DINARY_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# --- Phone app only ---
# Where the phone app finds the API: your Vercel domain. Not a secret (it is built into the app).
# In development you can leave it empty: the app then uses the Expo dev server, which also serves the API.
EXPO_PUBLIC_API_URL=https://your-project.vercel.app
