# Copy to `.env` and fill in from Supabase → Project Settings → API.
#
# Both values are embedded in the built app bundle, so ONLY the publishable
# anon key belongs here. The anon key is safe to ship: it grants no access on
# its own and every table is protected by Row Level Security.
#
# NEVER put the service_role key in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
